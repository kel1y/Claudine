# =============================================================================
# OpenCode self-hosted deployment — required configuration.
# Copy this file to `.env` and fill in every value marked PLACEHOLDER.
#     cp .env.example .env
# Then run: ./deploy.sh
# Never commit the real .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# Domain. Caddy will issue a real Let's Encrypt cert for this hostname.
# Point an A record at your server's public IP before running deploy.sh.
# Example: opencode.example.com
# ---------------------------------------------------------------------------
OPENCODE_DOMAIN=PLACEHOLDER.example.com

# Optional: email used by Let's Encrypt for expiry notices. Defaults to a throwaway.
OPENCODE_DOMAIN_EMAIL=PLACEHOLDER@example.com

# ---------------------------------------------------------------------------
# Server auth. Browser will prompt for these on first visit (HTTP Basic).
# Generate a strong password, e.g.:  openssl rand -base64 32
# ---------------------------------------------------------------------------
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=PLACEHOLDER-change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# LLM provider: NVIDIA NIM API (serves GLM-5.2 free tier on opencode by default).
# Get a key at https://build.nvidia.com/  ->  Login -> "Get API Key".
# Used as the model `nvidia/glm-5.2` (set as default in opencode.json).
# Leave blank to disable the nvidia provider; the server still starts.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=PLACEHOLDER-nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional: a remote git remote to mirror this deployment to (e.g. your fork).
# Leave blank unless you want the agent to push to a remote by default.
# ---------------------------------------------------------------------------
OPENCODE_REMOTE=

# ---------------------------------------------------------------------------
# Git identity for commits made by the agent inside the container.
# ---------------------------------------------------------------------------
GIT_AUTHOR_NAME=opencode
GIT_AUTHOR_EMAIL=opencode@example.com
GIT_COMMITTER_NAME=opencode
GIT_COMMITTER_EMAIL=opencode@example.com

# ---------------------------------------------------------------------------
# Logging. One of DEBUG | INFO | WARN | ERROR.
# ---------------------------------------------------------------------------
OPENCODE_LOG_LEVEL=INFO
